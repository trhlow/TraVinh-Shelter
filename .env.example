# === docker-compose.yml (local/dev — self-hosted Postgres container) ===

POSTGRES_DB=travinh_realty
POSTGRES_USER=travinh_app
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-this-pgadmin-password
PGADMIN_PORT=5050

JWT_SECRET=change-this-to-a-random-secret-at-least-32-bytes
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

SERVER_PORT=8080
BACKEND_PORT=8080
FRONTEND_PORT=3000
SPRING_PROFILES_ACTIVE=prod
MEDIA_STORAGE_PATH=/app/media
MEDIA_PUBLIC_URL_PREFIX=/api/v1/media
POSTGRES_VOLUME_NAME=travinh_realty_postgres_data
PGADMIN_VOLUME_NAME=travinh_realty_pgadmin_data
BACKEND_MEDIA_VOLUME_NAME=travinh_realty_backend_media

# === docker-compose.prod.yml (VPS Vietnix — external DO Managed Postgres + Caddy) ===
# JWT_SECRET, CORS_ALLOWED_ORIGINS, BACKEND_MEDIA_VOLUME_NAME above are reused as-is.
# Do NOT set POSTGRES_* above in production — there is no local Postgres container.

# DigitalOcean Managed PostgreSQL connection string, sslmode=require is mandatory
DB_URL=jdbc:postgresql://your-do-db-host:25060/travinh_realty?sslmode=require
DB_USERNAME=travinh_app
DB_PASSWORD=change-this-to-the-do-managed-db-password

# Domain pointed at the VPS via Cloudflare DNS, used by Caddy for automatic TLS
DOMAIN=your-domain.com

# Sentry DSNs (leave blank to disable)
SENTRY_DSN_BACKEND=
VITE_SENTRY_DSN=
VITE_GOOGLE_MAPS_EMBED_API_KEY=

# ghcr.io image refs used by docker-compose.prod.yml (set by the CI deploy job)
BACKEND_IMAGE=ghcr.io/trhlow/travinh-shelter-backend:latest
FRONTEND_IMAGE=ghcr.io/trhlow/travinh-shelter-frontend:latest

REDIS_VOLUME_NAME=travinh_realty_redis_data
CADDY_DATA_VOLUME_NAME=travinh_realty_caddy_data
CADDY_CONFIG_VOLUME_NAME=travinh_realty_caddy_config

# === Phase 2 — OTP notifications (password reset email + booking SMS anti-spam) ===
API_KEY_eSMS=your-esms-api-key
ESMS_SECRET_KEY=your-esms-secret-key
SMTP_USERNAME=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
